{
  "version": 1,
  "description": "Preset for .NET repos (Coverlet 100% threshold).",
  "steps": [
    { "name": "Restore", "command": "dotnet", "args": ["restore"] },
    { "name": "Guardrails", "command": "pwsh", "args": ["-File", "./scripts/workflowai-guardrails.ps1", "-ProjectPath", ".", "-CheckKiloCodeChangeMarkers"] },
    { "name": "Build", "command": "dotnet", "args": ["build", "-c", "Release", "--no-restore"] },
    {
      "name": "Tests+Coverage",
      "command": "dotnet",
      "args": [
        "test",
        "-c",
        "Release",
        "--no-build",
        "/p:CollectCoverage=true",
        "/p:CoverletOutputFormat=cobertura",
        "/p:Threshold=100",
        "/p:ThresholdType=line,branch,method"
      ]
    }
  ]
}
