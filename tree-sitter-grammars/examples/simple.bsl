// Расширенные примеры кода 1С

// Простая процедура без параметров
Процедура ПростаяПроцедура()
КонецПроцедуры

// Функция с параметрами
Функция СложитьЧисла(Число1, Число2)
  Возврат Число1 + Число2;
КонецФункции

// Экспортная процедура с параметрами
Процедура ОбработатьДанные(Знач Данные, РезультатОбработки) Экспорт
  Перем ВременнаяПеременная;
  ВременнаяПеременная = Данные;
  РезультатОбработки = ВременнаяПеременная;
КонецПроцедуры

// Функция с параметром по умолчанию
Функция ПолучитьЗначение(Значение = 0)
  Возврат Значение;
КонецФункции

// Примеры операторов управления потоком

// Условный оператор
Функция ПроверитьЗначение(Значение)
  Если Значение > 0 Тогда
    Возврат "Положительное";
  ИначеЕсли Значение < 0 Тогда
    Возврат "Отрицательное";
  Иначе
    Возврат "Ноль";
  КонецЕсли;
КонецФункции

// Цикл Пока
Процедура ЦиклПока()
  Перем Счетчик;
  Счетчик = 0;
  Пока Счетчик < 10 Цикл
    Счетчик = Счетчик + 1;
  КонецЦикла;
КонецПроцедуры

// Цикл Для
Функция СуммаЧисел(Н, К)
  Перем Сумма;
  Сумма = 0;
  Для Индекс = Н По К Цикл
    Сумма = Сумма + Индекс;
  КонецЦикла;
  Возврат Сумма;
КонецФункции

// Цикл Для Каждого
Процедура ОбработатьКоллекцию(Коллекция)
  Для Каждого Элемент Из Коллекция Цикл
    Если Элемент = 0 Тогда
      Продолжить;
    КонецЕсли;
    ОбработатьЭлемент(Элемент);
  КонецЦикла;
КонецПроцедуры

// Прерывание цикла
Функция НайтиЭлемент(Массив, ИскомоеЗначение)
  Для Каждого Элемент Из Массив Цикл
    Если Элемент = ИскомоеЗначение Тогда
      Возврат Истина;
    КонецЕсли;
  КонецЦикла;
  Возврат Ложь;
КонецФункции

// Сложные логические выражения
Функция ПроверитьУсловия(А, Б, В)
  Если (А > 0 И Б > 0) Или В > 10 Тогда
    Возврат Истина;
  КонецЕсли;
  Возврат Ложь;
КонецФункции

// Вложенные условия
Процедура ОпределитьКатегорию(Возраст, ИмеетПрава)
  Если Возраст >= 18 Тогда
    Если ИмеетПрава Тогда
      Результат = "Может водить";
    Иначе
      Результат = "Нужны права";
    КонецЕсли;
  Иначе
    Результат = "Слишком молод";
  КонецЕсли;
КонецПроцедуры